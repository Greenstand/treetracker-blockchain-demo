# Docker Environment Configuration
# This file is used for Docker containerized deployments

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_HYPERLEDGER_ENDPOINT=http://localhost:3001

# Auth Service Configuration
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:3000/api/v1

# Map Configuration
NEXT_PUBLIC_MAP_DEFAULT_LAT=0.0236
NEXT_PUBLIC_MAP_DEFAULT_LNG=37.9062
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=6

# App Configuration
NEXT_PUBLIC_APP_NAME=TreeTracker
NEXT_PUBLIC_OFFLINE_MODE=true

# Docker specific settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Development settings (for dev container)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true